---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Estrella from '../components/Estrella.astro';
import TarjetaProducto from '../components/TarjetaProducto.astro';
import Icono from '../components/iconos/Icono.astro';
import { MENSAJES, REDES, SITIO, TEXTOS } from '../config';
import { enlaceWhatsApp } from '../lib/whatsapp';
import { foto } from '../lib/fotos';
import { categorias, destacados, enlaceCategoria } from '../lib/catalogo';
import testimonios from '../data/testimonios.json';
import videos from '../data/tiktok.json';

const wa = enlaceWhatsApp(MENSAJES.general);

const beneficios = [
  'Grabado láser que no se borra',
  'Estuche Aura de regalo',
  'Delivery en Lima y envíos a provincias',
  'Pago coordinado por WhatsApp',
];

const pasos = [
  {
    titulo: 'Elige tu joya',
    texto: 'Mira el catálogo y escoge el modelo y el acabado: plateado, dorado u oro rosa.',
  },
  {
    titulo: 'Envíanos el nombre o la foto',
    texto: 'Por WhatsApp nos mandas el nombre, la frase, la fecha o la foto que quieres grabar. Revísalo bien: lo grabamos tal cual.',
  },
  {
    titulo: 'La grabamos y te la enviamos',
    texto: 'La grabamos con láser y te llega en su estuche Aura, con tarjeta de dedicatoria y pañito de limpieza.',
  },
];
---

<Base
  titulo="Joyas personalizadas en Lima | AURA Joyería"
  tituloCompleto
  descripcion="Collares, pulseras, llaveros y anillos personalizados con grabado láser: nombres, fechas, fotos y mascotas. Delivery en Lima y envíos a provincias. Pide por WhatsApp."
>
  <!-- ═════════ HERO ═════════ -->
  <section class="contenedor grid items-center gap-7 pt-4 pb-12 lg:grid-cols-[1fr_1.1fr] lg:gap-16 lg:pt-14 lg:pb-20">
    <div class="relative lg:order-2">
      <Image
        src={foto('hero-dijes-oro-rosa.jpg')}
        alt="Collares de oro rosa con dijes grabados con nombres, sobre una tela de lino"
        widths={[400, 560, 720, 960, 1200]}
        sizes="(min-width: 1152px) 560px, (min-width: 1024px) 50vw, calc(100vw - 40px)"
        quality={68}
        loading="eager"
        fetchpriority="high"
        class="aspect-[4/3] w-full rounded-[1.75rem] object-cover object-[50%_45%] lg:aspect-[8/7]"
      />
    </div>

    <div class="text-center lg:order-1 lg:text-left">
      <p class="etiqueta tracking-[0.14em] sm:tracking-[0.22em]">Joyería personalizada · Lima</p>
      <p class="mano mt-3 text-[clamp(2.5rem,13vw,3.4rem)] text-chocolate sm:text-[4.2rem]">{SITIO.lema}</p>
      <h1 class="mt-3 text-[1.85rem] sm:text-4xl lg:text-[2.8rem]">Joyas personalizadas grabadas con láser</h1>
      <p class="mx-auto mt-4 max-w-md lg:mx-0">Collares, pulseras, llaveros y anillos con el nombre, la fecha o la foto que tú elijas.</p>
      <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:justify-center lg:justify-start">
        <a href={wa} target="_blank" rel="noopener" class="btn btn-primario">
          <Icono nombre="whatsapp" class="size-[18px]" /> Personaliza tu joya
        </a>
        <a href="/catalogo/" class="btn btn-secundario">Ver catálogo</a>
      </div>
    </div>
  </section>

  <!-- ═════════ BENEFICIOS ═════════ -->
  <section aria-label="Por qué AURA" class="bg-beige">
    <ul class="contenedor grid grid-cols-2 gap-x-4 gap-y-5 py-7 lg:grid-cols-4">
      {
        beneficios.map((b) => (
          <li class="flex items-start gap-2.5 text-[0.8rem] leading-snug font-medium sm:text-sm">
            <span class="mt-[3px] text-dorado" aria-hidden="true">✦</span>
            {b}
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ═════════ CATEGORÍAS ═════════ -->
  <section class="contenedor py-16 lg:py-24" aria-labelledby="titulo-categorias">
    <div class="text-center">
      <p class="etiqueta">Categorías</p>
      <h2 id="titulo-categorias" class="mt-3 text-[1.7rem] sm:text-4xl">Encuentra tu joya</h2>
    </div>
    <ul class="mt-10 flex flex-wrap justify-center gap-x-3 gap-y-6 sm:gap-x-5">
      {
        categorias.map((c) => (
          <li class="w-[calc((100%-1.5rem)/3)] sm:w-[calc((100%-2.5rem)/3)] lg:w-[calc((100%-5rem)/5)]">
            <a href={enlaceCategoria(c)} class="group block text-center">
              <div class="aspect-square overflow-hidden rounded-2xl bg-beige">
                <Image
                  src={foto(c.foto)}
                  alt=""
                  widths={[160, 240, 320, 440]}
                  sizes="(min-width: 1024px) 210px, 30vw"
                  quality={70}
                  class="size-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
                />
              </div>
              <span class="mt-2.5 block text-[0.68rem] leading-tight font-semibold tracking-[0.14em] text-cafe uppercase sm:text-xs sm:tracking-[0.18em]">
                {c.nombre}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <Estrella />

  <!-- ═════════ DESTACADOS ═════════ -->
  <section class="contenedor py-16 lg:py-24" aria-labelledby="titulo-destacados">
    <div class="text-center">
      <p class="etiqueta">Destacados</p>
      <h2 id="titulo-destacados" class="mt-3 text-[1.7rem] sm:text-4xl">Joyas para regalar</h2>
    </div>
    <div class="mt-10 grid grid-cols-2 gap-x-4 gap-y-9 sm:gap-x-6 lg:grid-cols-3">
      {destacados.slice(0, 6).map((p) => <TarjetaProducto producto={p} />)}
    </div>
    <div class="mt-12 text-center">
      <a href="/catalogo/" class="btn btn-secundario">Ver todo el catálogo <Icono nombre="flecha" class="size-4" /></a>
    </div>
  </section>

  <!-- ═════════ CÓMO FUNCIONA ═════════ -->
  <section class="bg-beige" aria-labelledby="titulo-como">
    <div class="contenedor grid items-center gap-12 py-16 lg:grid-cols-2 lg:gap-20 lg:py-24">
      <div>
        <p class="etiqueta">Así de fácil</p>
        <h2 id="titulo-como" class="mt-3 text-[1.7rem] sm:text-4xl">Cómo funciona</h2>
        <ol class="mt-10 space-y-8">
          {
            pasos.map((paso, i) => (
              <li class="grid grid-cols-[3.25rem_1fr] gap-4">
                <span class="grid size-[3.25rem] place-items-center rounded-full border border-chocolate/30 font-titulo text-lg text-cafe">
                  {i + 1}
                </span>
                <div>
                  <h3 class="text-lg">{paso.titulo}</h3>
                  <p class="mt-1.5">{paso.texto}</p>
                </div>
              </li>
            ))
          }
        </ol>
        <a href={wa} target="_blank" rel="noopener" class="btn btn-primario mt-10 w-full sm:w-auto">
          <Icono nombre="whatsapp" class="size-[18px]" /> Empezar por WhatsApp
        </a>
      </div>
      <figure>
        <Image
          src={foto('presentacion-estuche-aura.jpg')}
          alt="Estuche de regalo AURA: bolsa, caja con la joya, tarjeta de dedicatoria y pañito"
          widths={[400, 600, 800, 1040]}
          sizes="(min-width: 1024px) 520px, calc(100vw - 40px)"
          quality={70}
          class="aspect-[4/3] w-full rounded-[1.75rem] object-cover"
        />
        <figcaption class="mt-4 text-center text-sm">{TEXTOS.incluye}</figcaption>
      </figure>
    </div>
  </section>

  <!-- ═════════ TESTIMONIOS ═════════ -->
  {
    testimonios.length > 0 && (
      <section class="py-16 lg:py-24" aria-labelledby="titulo-testimonios">
        <div class="contenedor text-center">
          <p class="mano text-[3.2rem] text-chocolate" aria-hidden="true">Gracias</p>
          <h2 id="titulo-testimonios" class="mt-2 text-[1.7rem] sm:text-4xl">Lo que dicen de AURA</h2>
        </div>
        <ul class="sin-barra contenedor mt-10 flex snap-x snap-mandatory gap-4 overflow-x-auto pb-2 lg:grid lg:grid-cols-3 lg:gap-6 lg:overflow-visible">
          {testimonios.map((t) => (
            <li class="w-[82%] shrink-0 snap-center rounded-2xl border border-chocolate/15 bg-crema p-7 sm:w-[60%] lg:w-auto">
              {t.ejemplo && <span class="etiqueta inline-block rounded-full bg-beige px-3 py-1 text-[0.65rem]">Ejemplo</span>}
              <p class="mt-4 text-dorado" aria-hidden="true">✦ ✦ ✦ ✦ ✦</p>
              <blockquote class="mt-3">“{t.texto}”</blockquote>
              <p class="etiqueta mt-5 text-[0.7rem]">
                {t.nombre} · {t.distrito}
              </p>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <!-- ═════════ TIKTOK ═════════ -->
  <section class="bg-beige" aria-labelledby="titulo-tiktok">
    <div class="contenedor py-16 lg:py-24">
      <div class="text-center">
        <p class="etiqueta">{REDES.usuario}</p>
        <h2 id="titulo-tiktok" class="mt-3 text-[1.7rem] sm:text-4xl">Síguenos en TikTok</h2>
      </div>
      <ul class="mx-auto mt-10 grid max-w-3xl grid-cols-3 gap-3 sm:gap-5">
        {
          videos.map((v) => (
            <li>
              <a href={v.enlace || REDES.tiktok} target="_blank" rel="noopener" class="group relative block overflow-hidden rounded-2xl">
                <Image
                  src={foto(v.portada)}
                  alt={v.titulo}
                  widths={[200, 320, 480]}
                  sizes="(min-width: 768px) 240px, 31vw"
                  class="aspect-[9/16] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                />
              </a>
            </li>
          ))
        }
      </ul>
      <div class="mt-10 text-center">
        <a href={REDES.tiktok} target="_blank" rel="noopener" class="btn btn-primario">
          <Icono nombre="tiktok" class="size-4" /> Ver en TikTok
        </a>
      </div>
    </div>
  </section>
</Base>
